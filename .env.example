# -----------------------------------------------------------------------
# Student Assignment Tracker API — environment variable template
# Copy this file to .env and edit as needed.
# Never commit .env to source control.
# -----------------------------------------------------------------------

# Comma-separated list of extra frontend origins to allow in addition to
# the four default local origins (localhost:3000, 5173, 4173, 8501).
# Leave empty to use only the defaults.
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173

# Set to "true" to allow ALL origins (wildcard CORS).
# FOR DEMO / LOCAL DEVELOPMENT ONLY — never use in production.
ALLOW_ALL_CORS=false
